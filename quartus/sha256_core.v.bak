	// SHA-256 compression core, adapted from the interface supplied in chat.
// One PADDED 512-bit chunk per request. Caller supplies the chaining value.
// Change from the original: expand ONE schedule word per clock (48 cycles),
// rather than creating one huge combinational schedule chain.
// start is accepted only when !busy; block and hin are latched at acceptance.
// hout is valid when done pulses. Add padding outside this module.
module sha256_core (
    input wire clk, rst, start,
    input wire [511:0] block,
    input wire [255:0] hin,
    output reg [255:0] hout,
    output reg done, busy
);
    reg [31:0] K [0:63];
    initial begin
        K[0]=32'h428a2f98; K[1]=32'h71374491; K[2]=32'hb5c0fbcf; K[3]=32'he9b5dba5;
        K[4]=32'h3956c25b; K[5]=32'h59f111f1; K[6]=32'h923f82a4; K[7]=32'hab1c5ed5;
        K[8]=32'hd807aa98; K[9]=32'h12835b01; K[10]=32'h243185be; K[11]=32'h550c7dc3;
        K[12]=32'h72be5d74; K[13]=32'h80deb1fe; K[14]=32'h9bdc06a7; K[15]=32'hc19bf174;
        K[16]=32'he49b69c1; K[17]=32'hefbe4786; K[18]=32'h0fc19dc6; K[19]=32'h240ca1cc;
        K[20]=32'h2de92c6f; K[21]=32'h4a7484aa; K[22]=32'h5cb0a9dc; K[23]=32'h76f988da;
        K[24]=32'h983e5152; K[25]=32'ha831c66d; K[26]=32'hb00327c8; K[27]=32'hbf597fc7;
        K[28]=32'hc6e00bf3; K[29]=32'hd5a79147; K[30]=32'h06ca6351; K[31]=32'h14292967;
        K[32]=32'h27b70a85; K[33]=32'h2e1b2138; K[34]=32'h4d2c6dfc; K[35]=32'h53380d13;
        K[36]=32'h650a7354; K[37]=32'h766a0abb; K[38]=32'h81c2c92e; K[39]=32'h92722c85;
        K[40]=32'ha2bfe8a1; K[41]=32'ha81a664b; K[42]=32'hc24b8b70; K[43]=32'hc76c51a3;
        K[44]=32'hd192e819; K[45]=32'hd6990624; K[46]=32'hf40e3585; K[47]=32'h106aa070;
        K[48]=32'h19a4c116; K[49]=32'h1e376c08; K[50]=32'h2748774c; K[51]=32'h34b0bcb5;
        K[52]=32'h391c0cb3; K[53]=32'h4ed8aa4a; K[54]=32'h5b9cca4f; K[55]=32'h682e6ff3;
        K[56]=32'h748f82ee; K[57]=32'h78a5636f; K[58]=32'h84c87814; K[59]=32'h8cc70208;
        K[60]=32'h90befffa; K[61]=32'ha4506ceb; K[62]=32'hbef9a3f7; K[63]=32'hc67178f2;
    end

    function [31:0] rotr;
        input [31:0] x; input integer n;
        begin rotr=(x>>n)|(x<<(32-n)); end
    endfunction
    function [31:0] sig0;
        input [31:0] x;
        begin sig0=rotr(x,7)^rotr(x,18)^(x>>3); end
    endfunction
    function [31:0] sig1;
        input [31:0] x;
        begin sig1=rotr(x,17)^rotr(x,19)^(x>>10); end
    endfunction
    function [31:0] bigsig0;
        input [31:0] x;
        begin bigsig0=rotr(x,2)^rotr(x,13)^rotr(x,22); end
    endfunction
    function [31:0] bigsig1;
        input [31:0] x;
        begin bigsig1=rotr(x,6)^rotr(x,11)^rotr(x,25); end
    endfunction

    reg [31:0] w [0:63];
    reg [31:0] a,b,c,d,e,f,g,h;
    reg [255:0] hin_latched;
    reg [5:0] t;
    reg [1:0] state;
    localparam IDLE=0, SCHEDULE=1, ROUNDS=2, FINALIZE=3;
    integer i;

    wire [31:0] choose=(e&f)^((~e)&g);
    wire [31:0] majority=(a&b)^(a&c)^(b&c);
    wire [31:0] t1=h+bigsig1(e)+choose+K[t]+w[t];
    wire [31:0] t2=bigsig0(a)+majority;
    // Each digest word is added modulo 2^32.
    wire [31:0] o0=hin_latched[255:224]+a;
    wire [31:0] o1=hin_latched[223:192]+b;
    wire [31:0] o2=hin_latched[191:160]+c;
    wire [31:0] o3=hin_latched[159:128]+d;
    wire [31:0] o4=hin_latched[127:96]+e;
    wire [31:0] o5=hin_latched[95:64]+f;
    wire [31:0] o6=hin_latched[63:32]+g;
    wire [31:0] o7=hin_latched[31:0]+h;

    always @(posedge clk) begin
        if (rst) begin
            state<=IDLE; busy<=0; done<=0; hout<=0; t<=0;
            hin_latched<=0;
            a<=0;b<=0;c<=0;d<=0;e<=0;f<=0;g<=0;h<=0;
            // Schedule entries are written before use; no reset required.
        end else begin
            done<=0;
            case (state)
                IDLE: if (start) begin
                    hin_latched<=hin;
                    {a,b,c,d,e,f,g,h}<=hin;
                    for (i=0;i<16;i=i+1)
                        w[i]<=block[511-i*32 -:32];
                    t<=16;busy<=1;state<=SCHEDULE;
                end
                SCHEDULE: begin
                    // Previous schedule entries were computed on earlier clocks.
                    w[t]<=sig1(w[t-2])+w[t-7]+sig0(w[t-15])+w[t-16];
                    if (t==63) begin t<=0;state<=ROUNDS;end
                    else t<=t+1'b1;
                end
                ROUNDS: begin
                    h<=g;g<=f;f<=e;e<=d+t1;
                    d<=c;c<=b;b<=a;a<=t1+t2;
                    if (t==63) state<=FINALIZE;
                    else t<=t+1'b1;
                end
                FINALIZE: begin
                    hout<={o0,o1,o2,o3,o4,o5,o6,o7};
                    busy<=0;done<=1;state<=IDLE;
                end
                default:begin state<=IDLE;busy<=0;end
            endcase
        end
    end
endmodule

module sha256_iv(output wire [255:0] iv);
    assign iv=256'h6a09e667_bb67ae85_3c6ef372_a54ff53a_510e527f_9b05688c_1f83d9ab_5be0cd19;
endmodule
